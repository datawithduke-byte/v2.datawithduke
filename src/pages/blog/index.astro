---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Fetch all posts and sort by date
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog | Data with Duke">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Blog Posts</h1>
    <div class="grid gap-8">
      {posts.map(post => (
        <a href={`/blog/${post.slug}/`} class="border p-6 rounded-xl hover:border-blue-500 transition-colors">
          <h2 class="text-2xl font-bold">{post.data.title}</h2>
          <p class="text-slate-600">{post.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>