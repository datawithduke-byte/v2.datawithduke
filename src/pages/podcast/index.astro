---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 1. Fetch all podcasts
const allPodcasts = await getCollection('podcast');

// 2. Sort: Season Descending, then Episode Descending
const sortedPodcasts = allPodcasts.sort((a, b) => {
  if (b.data.seasonNumber !== a.data.seasonNumber) {
    return b.data.seasonNumber - a.data.seasonNumber;
  }
  return b.data.episodeNumber - a.data.episodeNumber;
});

// 3. Group by Season Label
const podcastsBySeason = sortedPodcasts.reduce((acc: Record<string, any[]>, podcast) => {
  // This is the "Season: " & <seasonNumber> logic
  const seasonLabel = `Season ${podcast.data.seasonNumber}`;
  
  if (!acc[seasonLabel]) {
    acc[seasonLabel] = [];
  }
  acc[seasonLabel].push(podcast);
  return acc;
}, {});

// 4. Get the keys (Season labels)
const seasonLabels = Object.keys(podcastsBySeason).sort().reverse();
---

<BaseLayout title="Podcasts | Data with Duke">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <header class="mb-16">
      <h1 class="text-5xl font-black text-duke-blue mb-4">The Podcast</h1>
      <p class="text-xl text-slate-600 max-w-2xl">
        Musings, wonderings and the occasional rant about how data impacts our lives and world around us
      </p>
    </header>

    <div class="space-y-16">
      {seasonLabels.map(label => (
        <section>
          <h2 class="text-2xl font-bold border-b-2 border-duke-blue pb-2 mb-8 text-duke-blue">
            {label}
          </h2>
          
          <div class="grid gap-6 md:grid-cols-2">
            {podcastsBySeason[label].map(podcast => (
              <a href={`/podcast/${podcast.slug}/`} class="card-duke group">
                <div class="flex justify-between items-start mb-4">
                  <span class="text-xs font-mono font-bold bg-slate-100 px-2 py-1 rounded">
                    EP {podcast.data.episodeNumber.toString().padStart(2, '0')}
                  </span>
                  <span class="text-slate-400 text-xs italic">
                    {podcast.data.pubDate.toLocaleDateString('en-GB')}
                  </span>
                </div>
                
                <h3 class="text-xl font-bold group-hover:text-blue-600 transition-colors">
                  {podcast.data.title}
                </h3>
                <p class="text-slate-600 text-sm mt-2 line-clamp-2">
                  {podcast.data.description}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>