---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 1. Fetch the homepage settings with a total safety net
let homeSettings = null;
try {
  homeSettings = await getEntry('homepage' as any, 'index' as any);
} catch (e) {
  console.error("Homepage data not found in src/content/homepage/index.json", e);
}

// Extract data with absolute defaults
const heroTitle = homeSettings?.data?.heroTitle ?? "Hi, I'm Duke.";
const heroSubtitle = homeSettings?.data?.heroSubtitle ?? "Data isn't mystical. Let's take ownership of it.";
const ctaText = homeSettings?.data?.ctaText ?? "Explore the Data";
const featuredPostSlug = homeSettings?.data?.featuredPostSlug;

// [Persona: WebDev] Custom Dynamic Image Bank logic:
// We grab the current set index from Decap CMS and build our image path.
const heroImageNum = homeSettings?.data?.heroImageNumber ?? 1;
const heroImageUrl = `/assets/uploads/hero_${heroImageNum}.png`;

// 2. Fetch the featured blog post
let featuredPost = null;
try {
  if (featuredPostSlug) {
    featuredPost = await getEntry('blog' as any, featuredPostSlug);
  }

  // Fallback: If no slug is set, grab the most recent post
  if (!featuredPost) {
    const allPosts = await getCollection('blog' as any);
    if (allPosts && allPosts.length > 0) {
      featuredPost = allPosts.sort((a, b) => 
        new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
      )[0];
    }
  }
} catch (e) {
  console.warn("Could not load featured post", e);
}
---

<BaseLayout title="Data With Duke | Home">
  <!-- Hero Section -->
  <section class="py-24 px-4 max-w-6xl mx-auto text-center">
    <h1 class="text-5xl md:text-7xl font-extrabold mb-6 bg-gradient-to-r from-blue-900 to-blue-700 bg-clip-text text-transparent">
      {heroTitle}
    </h1>
    <p class="text-xl text-slate-600 mb-10 max-w-2xl mx-auto leading-relaxed">
      {heroSubtitle}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/podcast" class="btn-primary">
        {ctaText}
      </a>
      <a href="/blog" class="px-6 py-2.5 rounded-xl font-bold text-slate-600 hover:bg-slate-100 transition-all border border-slate-200">
        Read the Blog
      </a>
    </div>
  </section>

  <!-- Featured Showcase Section -->
  {featuredPost && (
    <section class="py-20 bg-slate-100/50 border-y border-slate-200/60">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex justify-between items-end mb-10">
          <div>
            <h2 class="text-3xl font-bold text-slate-900">Featured Insight</h2>
            <p class="text-slate-500 mt-1">Hand-picked for you today</p>
          </div>
          <a href="/blog" class="text-blue-900 font-semibold hover:underline decoration-2 underline-offset-4">View all posts →</a>
        </div>

        <div class="card-duke grid md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1">
            <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-blue-900 text-xs font-bold uppercase tracking-wider mb-4">
              Latest Story
            </span>
            <h3 class="text-3xl font-bold mb-4 text-slate-900 leading-tight">{featuredPost.data.title}</h3>
            <p class="text-lg text-slate-600 mb-8 leading-relaxed">{featuredPost.data.description}</p>
            <a href={`/blog/${featuredPost.slug}`} class="btn-gold inline-block">
              Keep Reading
            </a>
          </div>
          
          <!-- 
            [Persona: WebDev] Solution:
            Instead of a static blue SVG container fallback, we now load the dynamic 
            image bank asset 'heroImageUrl' if the featured post doesn't declare a unique heroImage.
          -->
          <div class="order-1 md:order-2">
            {featuredPost.data.heroImage ? (
              <img 
                src={featuredPost.data.heroImage} 
                alt={featuredPost.data.title} 
                class="rounded-3xl shadow-2xl object-cover h-80 w-full hover:scale-[1.02] transition-transform duration-500"
              />
            ) : (
              <img 
                src={heroImageUrl} 
                alt={featuredPost.data.title} 
                class="rounded-3xl shadow-2xl object-cover h-80 w-full hover:scale-[1.02] transition-transform duration-500"
                onerror="this.onerror=null; this.src='/assets/uploads/hero-1.jpg';"
              />
            )}
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>